{
    "name": "jrrdnx/craft-cloudflare-r2",
    "description": "Cloudflare R2 integration for Craft CMS",
    "type": "craft-plugin",
    "version": "2.0.0-alpha.1",
    "keywords": [
        "s3",
        "cms",
        "craftcms",
        "flysystem",
        "cloudflare",
        "r2"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jarrod D Nix",
            "homepage": "https://jarrodnix.dev/"
        }
    ],
    "support": {
        "issues": "https://github.com/jrrdnix/craft-cloudflare-r2/issues",
        "docs": "https://jarrodnix.dev/plugins/cloudflare-r2/v2/"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-alpha.8",
        "aws/aws-sdk-php": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "craftcms/rector": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "jrrdnx\\cloudflarer2\\": "src/"
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "extra": {
        "class": "jrrdnx\\cloudflarer2\\Plugin",
        "name": "Cloudflare R2",
        "handle": "cloudflare-r2",
        "documentationUrl": "https://jarrodnix.dev/plugins/cloudflare-r2/v2/"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    }
}
